<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="291dp"
        android:layout_height="103dp"
        app:srcCompat="@drawable/logo"
        tools:layout_editor_absoluteX="59dp"
        tools:layout_editor_absoluteY="16dp" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="85dp"
        android:layout_height="23dp"
        android:paddingLeft="10dp"
        android:text="US English"
        tools:layout_editor_absoluteX="251dp"
        tools:layout_editor_absoluteY="140dp" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="72dp"
        android:layout_height="24dp"
        android:paddingLeft="10dp"
        android:text="Welcome"
        tools:layout_editor_absoluteX="45dp"
        tools:layout_editor_absoluteY="141dp" />

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="29dp"
        android:layout_height="25dp"
        app:srcCompat="@drawable/icon_dropdown"
        tools:layout_editor_absoluteX="336dp"
        tools:layout_editor_absoluteY="140dp"

        />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp"
        tools:layout_editor_absoluteX="45dp"
        tools:layout_editor_absoluteY="160dp">

        <!-- Add your TextInputEditText inside the layout -->
        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Username" />

    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp"
        tools:layout_editor_absoluteX="45dp"
        tools:layout_editor_absoluteY="225dp"
        >



        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Password" />

    </com.google.android.material.textfield.TextInputLayout>

    <ImageView
        android:id="@+id/imageView5"
        android:layout_width="317dp"
        android:layout_height="182dp"
        app:srcCompat="@drawable/stay_tuned"
        tools:layout_editor_absoluteX="51dp"
        tools:layout_editor_absoluteY="434dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button"
        android:layout_width="310dp"
        android:layout_height="55dp"
        android:text="Button"
        android:textColor="#000000"
        app:backgroundTint="#9d9fa1"
        app:cornerRadius="12dp"
        tools:layout_editor_absoluteX="52dp"
        tools:layout_editor_absoluteY="355dp" />

    <ImageView
        android:id="@+id/imageView3"
        android:layout_width="26dp"
        android:layout_height="25dp"
        app:srcCompat="@drawable/lock"
        tools:layout_editor_absoluteX="45dp"
        tools:layout_editor_absoluteY="315dp" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Can't Sign in?"
        tools:layout_editor_absoluteX="78dp"
        tools:layout_editor_absoluteY="321dp" />

    <TextView
        android:id="@+id/textView4"
        android:layout_width="98dp"
        android:layout_height="18dp"
        android:text="Remember Me"
        tools:layout_editor_absoluteX="252dp"
        tools:layout_editor_absoluteY="322dp" />

    <CheckBox
        android:id="@+id/checkBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        tools:layout_editor_absoluteX="337dp"
        tools:layout_editor_absoluteY="307dp" />

    <LinearLayout
        android:layout_width="329dp"
        android:layout_height="48dp"
        android:background="@drawable/black_rounded_bg"
        android:orientation="horizontal"
        tools:layout_editor_absoluteX="45dp"
        tools:layout_editor_absoluteY="654dp">

        <ImageView
            android:id="@+id/imageView6"
            android:layout_width="44dp"
            android:layout_height="35dp"
            app:srcCompat="@drawable/support"
            android:paddingLeft="3dp"
            android:layout_marginLeft="35dp"
            android:layout_gravity="center"/>

        <ImageView
            android:id="@+id/imageView7"
            android:layout_width="37dp"
            android:layout_height="35dp"
            app:srcCompat="@drawable/location"
            android:layout_marginLeft="30dp"
            android:layout_gravity="center"/>

        <ImageView
            android:id="@+id/imageView8"
            android:layout_width="32dp"
            android:layout_height="28dp"
            app:srcCompat="@drawable/register"
            android:layout_marginLeft="30dp"
            android:layout_gravity="center"/>

        <ImageView
            android:id="@+id/imageView9"
            android:layout_width="31dp"
            android:layout_height="35dp"
            app:srcCompat="@drawable/verify"
            android:layout_gravity="center"
            android:layout_marginLeft="30dp"/>

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>